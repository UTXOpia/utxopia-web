# UTXOpia Frontend Environment Variables
#
# Program addresses default to devnet (from @utxopia/sdk DEVNET_CONFIG).
# To use a different deployment, set these env vars.
# All PDAs (pool state, commitment tree, pool vault) are auto-derived.

# ── Required ──────────────────────────────────────

# Network identifier
NEXT_PUBLIC_NETWORK=devnet

# Backend API URL (server-side + client-side).
# Production (Vercel) uses the Cloudflare-tunnelled backend:
BACKEND_API_URL=https://api.utxopia.com
NEXT_PUBLIC_BACKEND_API_URL=https://api.utxopia.com
# For purely-local dev (Docker backend on host:3010), override both to http://localhost:3010

# Backend API key (must match BACKEND_API_KEY on the backend)
BACKEND_API_KEY=

# ── Program Overrides (optional — defaults to devnet) ──

# Open Privacy and Verified Privacy identities are fixed in vault-config.ts
# and coexist at runtime. Do not select a whole deployment with an env version.

# ── Token Mint Overrides (optional — for custom deployments) ──

# NEXT_PUBLIC_WSOL_MINT=
# NEXT_PUBLIC_USDC_MINT=
# NEXT_PUBLIC_USDT_MINT=

# ── Bitcoin Network ──

# Bitcoin network for address validation and explorer links
# Options: testnet4, testnet, mainnet, regtest
NEXT_PUBLIC_BTC_NETWORK=testnet4

# ── Solana RPC ──

# Solana RPC Endpoint (falls back to public devnet if not set)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# ── MagicBlock PER policy coprocessor ──

# Vault policy is request-scoped by `vault=open|verified`; it is not selected
# through a global frontend environment version or privacy-domain variable.
# PER endpoints, authentication, allowlists, and signing keys live only in the
# Rust backend.

# ── Sui Testnet POC ──

# These are generated by `UTXOPIA_NETWORK=sui-testnet ./scripts/sync-env.sh`.
NEXT_PUBLIC_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
UTXOPIA_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
# NEXT_PUBLIC_SUI_PACKAGE_ID=
# NEXT_PUBLIC_SUI_POOL_ID=
# NEXT_PUBLIC_SUI_NULLIFIER_REGISTRY_ID=
# NEXT_PUBLIC_SUI_REDEMPTION_QUEUE_ID=
# NEXT_PUBLIC_SUI_VERIFYING_KEY_REGISTRY_ID=
# NEXT_PUBLIC_SUI_RELAYER_ADDRESS=
UTXOPIA_SUI_RELAYER_ADDRESS=
UTXOPIA_SUI_RELAYER_KEYPAIR_PATH=
UTXOPIA_SUINS_PARENT_NFT_ID=
# NEXT_PUBLIC_SUI_IKA_NETWORK=testnet
# NEXT_PUBLIC_SUI_IKA_PACKAGE=
# NEXT_PUBLIC_SUI_IKA_SYSTEM_OBJECT_ID=
# NEXT_PUBLIC_SUI_IKA_DWALLET_COORDINATOR_ID=

# ── Sui zkLogin ──

# Google Cloud OAuth client ID for a "Web application" client.
# Authorized JavaScript origin for production:
#   https://utxopia.com
# Authorized redirect URI for production:
#   https://utxopia.com/sui
# Add the same localhost origin/redirect URI for local development if needed.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_ZKLOGIN_REDIRECT_URI=https://utxopia.com/sui

# ── Privy Auth / Embedded Solana Wallets ──

# Enables Privy passkey/email login and Solana embedded wallets for optional
# .utxopia.sol name ownership. If unset, the app falls back to local passkeys
# and external Solana wallet-adapter only.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional Privy app client ID, if configured in the Privy dashboard.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Server-only secret used by /api/sui/zklogin/salt to derive deterministic salts.
# Generate with: openssl rand -hex 32
ZKLOGIN_SALT_SECRET=

# Optional external services. If salt URL is empty, the app uses /api/sui/zklogin/salt.
# NEXT_PUBLIC_ZKLOGIN_SALT_SERVER_URL=
# NEXT_PUBLIC_ZKLOGIN_PROVER_URL=

# Helius API Key (recommended for better RPC reliability)
# Get a free key at https://dev.helius.xyz
NEXT_PUBLIC_HELIUS_API_KEY=
HELIUS_API_KEY=

# ── ZK Circuit Artifacts ──

# Circuit artifacts location.
# Repo ships only *.vkey.json (~112KB). wasm/zkey live in a GitHub Release;
# fetch with `bash scripts/fetch-circuits.sh` then copy to web/public/circuits.
# Use '/circuits', a CDN root, or a complete path ending in '/groth16'.
# Remote CDNs must allow browser GET/HEAD requests from the web app origin.
# Path '/circuits' is served by Next.js from web/public/circuits/.
# Production uses the versioned R2 custom domain directly. The same-origin
# /circuit-assets/groth16 rewrite remains available as an emergency fallback.
NEXT_PUBLIC_CIRCUIT_CDN_URL=https://circuit.utxopia.com/circuits/v2/groth16

# ── Server-side Keypairs (JSON array format: [1,2,3,...,64]) ──

# Admin keypair — required for demo/mock deposits
# ADMIN_KEYPAIR=

# Relayer keypair — for header relay and transaction relay
# RELAYER_KEYPAIR=
# RELAYER_KEYPAIR_PATH=~/.config/solana/id.json

# ── Beta intake (/api/feedback and /api/apply) ──

# At least one sink is required or the routes return 503 and the form tells the
# member to email instead. Silently accepting feedback into nowhere is worse.

# Email. For feedback this is a sink and replies reach whoever wrote in. For
# applications it is not a sink at all any more — it is only how the applicant's
# invite is sent, and INTAKE_EMAIL_TO is that mail's reply-to rather than a
# recipient. Applications are recorded in the database and read at
# /admin/applications; exactly one mail goes out per application.
# The default sender needs no DNS setup but only delivers to the Resend account
# owner's own address; verify a domain to send anywhere else.
# RESEND_API_KEY=
# Comma-separated for more than one recipient. Put the inbox you answer from
# first — send-invite.ts uses it as the invite mail reply-to, which takes one.
# INTAKE_EMAIL_TO=you@example.com,info@example.com
# Use the `Name <address>` form: a bare address makes Gmail label the thread
# with the local part, so mail from beta@ lands in an inbox reading "beta".
# INTAKE_EMAIL_FROM=UTXOpia <onboarding@resend.dev>

# Incoming webhook — Discord and Slack both work; the payload carries
# `content`, `text` and a structured `entry` object.
# FEEDBACK_WEBHOOK_URL=

# JSONL append target. Useful for local runs and self-hosting; on Vercel the
# filesystem is ephemeral, so use the webhook there.
# FEEDBACK_LOG_PATH=/var/lib/utxopia/feedback.jsonl

# Shown as the fallback when delivery fails. Defaults to beta@utxopia.com.
# NEXT_PUBLIC_FEEDBACK_EMAIL=beta@utxopia.com

# ── Beta applications (/api/apply) ──

# Same shape, and both fall back to the feedback sinks above — set only
# FEEDBACK_WEBHOOK_URL and applications land in the same channel. Split them
# when screening in the same room as bug reports starts to hurt.
# APPLY_WEBHOOK_URL=
# APPLY_LOG_PATH=/var/lib/utxopia/applications.jsonl

# Auto-issue. Set this and every application mints a code and mails it
# immediately; leave it unset and the route sends the "a person will read it"
# receipt instead, which is what shipped before. Must match
# UTXOPIA_INVITE_ADMIN_KEY on the backend, and BACKEND_API_KEY must be set too —
# the mint endpoint takes both keys. Server-only: never NEXT_PUBLIC_.
#
# Worth knowing before you turn it on: a redeemed code is a permanent on-chain
# member entry, and the only thing bounding how many get minted is the /api/apply
# rate limiter (3 per IP per 10 minutes).
# UTXOPIA_INVITE_ADMIN_KEY=
# Which deployment the code is minted against, and the network in the redeem
# link. Not taken from the request — a submitted value would aim the mint.
# INVITE_NETWORK=devnet-regtest
# INVITE_CODE_DAYS=14
# INVITE_LABEL=auto-apply
# Origin for the redeem link. www, not the apex: utxopia.com 308-redirects
# there, and a redirect is one more hop to mangle a link carrying a code.
# APP_URL=https://www.utxopia.com
